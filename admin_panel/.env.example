# Backend (bu repoda projects/tarimiklim/backend — varsayılan port 8088)
# RTK Query ve weather-admin API istekleri NEXT_PUBLIC_API_URL üzerinden gider.
PANEL_API_URL=http://127.0.0.1:8088
NEXT_PUBLIC_API_URL=http://127.0.0.1:8088/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8088/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3096
NEXT_PUBLIC_APP_NAME=Tarım İklim Admin
# Opsiyonel: sidebar ve ust bar ikinci satiri (bos birakilabilir)
NEXT_PUBLIC_ADMIN_BRAND_SUBTITLE=Yönetim
NEXT_PUBLIC_APP_COPYRIGHT=Tarım İklim
NEXT_PUBLIC_APP_DESCRIPTION=Hava, don uyarısı ve konum yönetimi — env ve API üzerinden.
# Opsiyonel: giriş sol panel (bos birakilirsa ceviri / site_settings kullanilir)
# NEXT_PUBLIC_ADMIN_LOGIN_HEADING=
# NEXT_PUBLIC_ADMIN_LOGIN_QUOTE=
# Opsiyonel: /admin/tarimiklim ozet basligi (locale weatherModule uzerine yazar)
# NEXT_PUBLIC_ADMIN_WEATHER_HUB_TITLE=
# NEXT_PUBLIC_ADMIN_WEATHER_HUB_SUBTITLE=
# Opsiyonel: geliştirici giriş ipuçları (login sayfasına eklenebilir; seed ile aynı tutun)
# NEXT_PUBLIC_DEV_LOGIN_HINT_EMAIL=orhanguzell@gmail.com
# NEXT_PUBLIC_DEV_LOGIN_HINT_PASSWORD=admin123
NEXT_PUBLIC_SITE_NAME=
# SERP onizlemesi ve noreply@ placeholder icin (ornekleme.com)
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_DEVELOPER_URL=
NEXT_PUBLIC_DEVELOPER_NAME=
