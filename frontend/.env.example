# Public API (Fastify) — trailing slash yok
NEXT_PUBLIC_API_URL=http://127.0.0.1:8088/api/v1

# Site (canonical origin, sitemap / metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3088

# Marka — boşsa src/config/site-defaults.json kullanılır
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_COPYRIGHT=
NEXT_PUBLIC_LOGO_ALT=
NEXT_PUBLIC_OG_SITE_NAME=

# Admin panel /api/revalidate-proxy için secret
REVALIDATE_SECRET=dev-only-set-REVALIDATE_SECRET
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
